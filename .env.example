# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site
NEXT_PUBLIC_SITE_URL=https://compicfy.com
NEXT_PUBLIC_SITE_NAME=ComPicfy
NEXT_PUBLIC_APP_URL=https://compicfy.com

# AI
GROQ_API_KEY=gsk_your_groq_api_key_here

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Email
SMTP_HOST=mail.compicfy.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=support@compicfy.com

# Feature Flags
NEXT_PUBLIC_ENABLE_AFFILIATE=true

# Affiliate
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=your_amazon_tag
ENTERTAINMENT_EARTH_AFFILIATE_ID=your_ee_id
BLIPPO_AFFILIATE_ID=your_blippo_id
EBAY_AFFILIATE_ID=your_ebay_id
ETSY_AFFILIATE_ID=your_etsy_id

# Payments
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public
FLUTTERWAVE_SECRET_KEY=FLWSECK-your_flutterwave_secret
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your_flutterwave_public
FLUTTERWAVE_WEBHOOK_HASH=your_flw_webhook_hash
PAYSTACK_PLAN_CODE_MONTHLY=PLN_xxxxxxxxxxxxxxx
PAYSTACK_PLAN_CODE_ANNUAL=PLN_xxxxxxxxxxxxxxx

# Discord
DISCORD_PRO_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Cron
CRON_SECRET=your_random_secret_string_here

# Push Notification
VAPID_SUBJECT=your_vapid_subject_here
INTERNAL_API_SECRET=your_internal_api_secret_here
WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_here\n-----END PRIVATE KEY-----\n"

Mangaupdate API
MANGAUPDATES_API_TOKEN=your_mangaupdates_api_token_here